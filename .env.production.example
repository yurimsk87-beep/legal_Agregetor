# Production environment for pravopoisk.ru (Node + PM2 + Nginx / FastPanel)
#
# On the VPS copy this to .env (NOT .env.production), so that BOTH Next.js and the
# Prisma CLI read the same file:
#     cp .env.production.example .env
# Then fill every CHANGE_ME value. Never commit the real .env.
#
# NOTE: NEXT_PUBLIC_* are inlined at BUILD time — this file must exist before `npm run build`.

# ---- Database (local PostgreSQL on the VPS) ----
DATABASE_URL=postgresql://legal_user:CHANGE_ME_db_password@localhost:5432/legal_aggregator?schema=public

# ---- Public site URL (must match the live domain, no trailing slash) ----
SITE_URL=https://pravopoisk.ru
NEXT_PUBLIC_SITE_URL=https://pravopoisk.ru

# ---- Auth secrets — MUST be 32+ random chars in production ----
# Generate each:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_32_random_chars
AUTH_SECRET=CHANGE_ME_min_32_random_chars

# ---- Initial admin (used by `npm run prisma:seed`; change after first login) ----
ADMIN_EMAIL=admin@pravopoisk.ru
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# ---- Search Console / Webmaster verification (fill after creating the properties) ----
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# ---- SEO-merge middleware: keep disabled behind a proxy unless you rely on DB merges ----
ENABLE_SEO_MERGE_MIDDLEWARE=false

# ---- Search engines: site is OPEN; only individual question pages are hidden ----
# "true" (default) → individual question pages (/questions/<slug>) return
# "X-Robots-Tag: noindex, follow"; the /questions hub (landing) stays indexable.
# When question content is ready: set to "false", then `npm run build` + `pm2 reload`.
BLOCK_QUESTIONS_INDEXING=true

# ---- Internal bot-visit endpoint signing (optional but recommended) ----
BOT_VISIT_SECRET=CHANGE_ME_random_token

# ---- Storage ----
STORAGE_DRIVER=local
MAX_UPLOAD_SIZE_MB=10
# Closed PDFs sent for lawyer review. Must be outside public/ and writable by the app user.
LEAD_ATTACHMENT_STORAGE_ROOT=/var/lib/pravopoisk/lead-attachments

# ---- Repository timeouts (production defaults are generous; tune if needed) ----
REPOSITORY_QUERY_TIMEOUT_MS=5000

# ---- Optional: Redis (only if a local Redis is running; the MVP works without it) ----
REDIS_URL=

# ---- Optional public platform contacts (leave empty until confirmed) ----
NEXT_PUBLIC_PLATFORM_NAME=ПравоПоиск
NEXT_PUBLIC_PLATFORM_PHONE=
NEXT_PUBLIC_PLATFORM_EMAIL=

