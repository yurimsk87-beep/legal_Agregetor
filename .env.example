# Required: PostgreSQL connection string.
# Docker compose value: postgresql://postgres:postgres@postgres:5432/legal_aggregator?schema=public
# Local host value:  postgresql://postgres:postgres@localhost:5432/legal_aggregator?schema=public
DATABASE_URL=

# Required in production: canonical public URL without trailing slash.
SITE_URL=https://example.ru
NEXT_PUBLIC_SITE_URL=https://example.ru

# Required in production: at least 32 random characters.
JWT_SECRET=
AUTH_SECRET=

# Optional: initial admin created by `npm run prisma:seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: verification and analytics.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
YANDEX_IKS=

# Analytics/marketing tags are managed via Google Tag Manager (container GTM-PZF8W7C4,
# hard-coded in src/app/layout.tsx). No analytics ID env vars are required.

# Optional: public platform contacts. Leave empty if there is no confirmed contact.
NEXT_PUBLIC_PLATFORM_NAME=ПравоПоиск
PLATFORM_LEGAL_NAME=
PLATFORM_INN=
PLATFORM_OGRN=
NEXT_PUBLIC_PLATFORM_PHONE=
NEXT_PUBLIC_PLATFORM_EMAIL=
NEXT_PUBLIC_PLATFORM_ADDRESS=
NEXT_PUBLIC_PLATFORM_WORK_HOURS=Ежедневно с 9:00 до 21:00 по московскому времени
NEXT_PUBLIC_PLATFORM_REGIONS=Вся Россия
NEXT_PUBLIC_YANDEX_REGION=Россия

# Optional: Redis is present in docker-compose, but the MVP can run without Redis-backed features.
# The rate limiter currently uses in-memory counters; set REDIS_URL when wiring a shared limiter.
REDIS_URL=

# Optional: set to "false" to disable the SEO-merge lookup in middleware (default: enabled).
# Results are cached in-process with a short TTL; this flag is an escape hatch under load.
ENABLE_SEO_MERGE_MIDDLEWARE=

# Optional: repository and form timeouts.
REPOSITORY_QUERY_TIMEOUT_MS=800
REPOSITORY_DB_RETRY_DELAY_MS=30000
QUESTION_FORM_DB_TIMEOUT_MS=5000

# Optional: internal bot-visit endpoint signing.
BOT_VISIT_SECRET=

# Optional: storage. Default local mode stores uploads in public/uploads.
STORAGE_DRIVER=local
MAX_UPLOAD_SIZE_MB=10
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Optional: diagnostics.
PRISMA_LOG_ERRORS=false
SEO_AUDIT_MAX_PAGES=250
SEO_AUDIT_MAX_INTERNAL_LINKS=250
SEO_AUDIT_CONCURRENCY=8
SEO_AUDIT_FETCH_TIMEOUT_MS=30000

# Development/test only. Do not set this for production demo accounts.
DEMO_LAWYER_PASSWORD=

# AI-навигатор: видимость карточки на фронтенде (feature flag).
# AI_NAVIGATOR_ENABLED:   true | false — глобальный выключатель карточки.
# AI_NAVIGATOR_VISIBLE_TO: admin | all — кому показывать, если ENABLED=true.
#   enabled=false                  → карточки нет ни у кого (backend /api/ai-navigator/ при этом доступен);
#   enabled=true, visibleTo=admin  → карточку видят только пользователи с ролью ADMIN;
#   enabled=true, visibleTo=all    → карточку видят все.
# Для безопасного первого прод-деплоя: ENABLED=false, затем admin-only, потом all.
AI_NAVIGATOR_ENABLED=false
AI_NAVIGATOR_VISIBLE_TO=admin

# AI-навигатор (/api/ai-navigator/). LLM улучшает только текстовые поля
# (summary/steps/clarifyingQuestions). По умолчанию выключено — endpoint работает
# без ключей. Включается только при ENABLED=true И заданных API_KEY+BASE_URL+MODEL.
AI_NAVIGATOR_LLM_ENABLED=false
AI_PROVIDER=openai_compatible
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_LLM_TIMEOUT_MS=15000
