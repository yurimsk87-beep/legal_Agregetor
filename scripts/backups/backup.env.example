APP_DIR=/var/www/legal-aggregator
UPLOADS_DIR=/var/www/legal-aggregator/public/uploads
DATABASE_URL=postgresql://legal_user:CHANGE_ME@localhost:5432/legal_aggregator?schema=public

# Restic encrypts data before it leaves the VPS.
RESTIC_REPOSITORY=s3:https://s3.example.com/pravopoisk-backups
RESTIC_PASSWORD_FILE=/etc/legal-aggregator/restic-password

# S3-compatible storage credentials. Keep real values outside Git.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12
